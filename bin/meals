#!/usr/bin/env python3
"""meals - tiny meal planner that prices a dish's ingredients across UK supermarkets.

Usage:
  meals 'mashed potatoes with tuna' [--servings 2] [--json] [--no-cache]

Pipeline (only `tinyfish search` + `tinyfish fetch`, no APIs, no browser):
  1. find a recipe for the dish          -> search (skipped on recipe-cache hit)
  2. read the recipe page                -> fetch, extract ingredients
  3. price each ingredient               -> search site:trolley.co.uk -> fetch product page
  4. per-store totals + cheapest store
"""

import argparse
import json
import os
import re
import sys
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from collections import defaultdict

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from lib import common
from lib.recipes_store import load_recipes, save_recipes

STORES = [
    "Tesco", "Asda", "Sainsbury's", "Sainsburys", "Morrisons",
    "Waitrose", "Aldi", "Lidl", "Ocado", "Iceland", "Co-op",
]


# thin wrappers over lib/common.py (helpers moved verbatim); keep names stable
def run(args, timeout=60):
    return common.run(args, timeout)


def search(q):
    return common.search(q)


def fetch_text(url):
    return common.fetch_text(url)


def find_recipe(dish):
    return common.find_recipe(dish)


def extract_title(text):
    return common.extract_title(text)


def extract_ingredients(text):
    return common.extract_ingredients(text)


def clean_item(line):
    return common.clean_item(line)


def price_item(name):
    urls = search(f"site:trolley.co.uk {name}")
    trolley = next((u for u in urls if "trolley.co.uk/product/" in u), None)
    if not trolley:
        return {}
    text = fetch_text(trolley)
    return parse_store_prices(text)


def parse_store_prices(text):
    quotes = {}
    lines = [l.strip() for l in text.split("\n") if l.strip()]
    for i, l in enumerate(lines):
        store = next((s for s in STORES if l.lower().rstrip("'s") == s.lower().rstrip("'s")
                      or l == s), None)
        if not store:
            continue
        store = "Sainsbury's" if store in ("Sainsburys",) else store
        for j in range(i + 1, min(i + 4, len(lines))):
            pm = re.match(r"^£(\d+\.\d{1,2})$", lines[j])
            if pm:
                price = float(pm.group(1))
                unit = lines[j + 1] if j + 1 < len(lines) and re.match(
                    r"^£[\d.]+ per ", lines[j + 1]) else ""
                cur = quotes.get(store)
                if cur is None or price < cur["price"]:
                    quotes[store] = {"price": price, "unit": unit}
                break
    return quotes


def main():
    ap = argparse.ArgumentParser(prog="meals")
    ap.add_argument("dish", nargs="+")
    ap.add_argument("--servings", type=int, default=2)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-cache", action="store_true", help="force re-search/re-fetch of the recipe")
    args = ap.parse_args()
    dish = " ".join(args.dish)

    recipes = load_recipes()
    url, title, ingredients = "", "", []
    if not args.no_cache and dish in recipes:
        r = recipes[dish]
        url, title = r["url"], r["title"]
        ingredients = [i["raw"] for i in r["ingredients"]]
        print(f"recipe: cache hit ({title})", file=sys.stderr, flush=True)
    else:
        print(f"→ finding a recipe for '{dish}'...", file=sys.stderr, flush=True)
        url, title, ingredients = find_recipe(dish)
        if ingredients:
            save_recipes(dish, {
                "title": title,
                "url": url,
                "servings_base": args.servings,
                "ingredients": [
                    {"raw": line, **dict(zip(("name", "qty", "unit"), clean_item(line)))}
                    for line in ingredients
                ],
                "cached_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            })
        print("recipe: fetched", file=sys.stderr, flush=True)
    if not ingredients:
        print(json.dumps({"error": "no recipe / ingredients found", "dish": dish}))
        sys.exit(1)
    print(f"  recipe: {title} ({url})", file=sys.stderr, flush=True)

    items = []
    for line in ingredients:
        name, qty, unit = clean_item(line)
        if len(name) < 2:
            continue
        items.append({"raw": line, "name": name, "qty": qty, "unit": unit})

    print(f"→ pricing {len(items)} items across stores (in parallel)...", file=sys.stderr, flush=True)
    with ThreadPoolExecutor(max_workers=4) as ex:
        futs = {ex.submit(price_item, it["name"]): it for it in items}
        for fut in as_completed(futs):
            it = futs[fut]
            it["quotes"] = fut.result()
            n = len(it["quotes"])
            print(f"  {it['name']:<32} {n} store(s)", file=sys.stderr, flush=True)

    totals = defaultdict(float)
    missing = []
    for it in items:
        if not it["quotes"]:
            missing.append(it["name"])
            continue
        for store, q in it["quotes"].items():
            totals[store] += q["price"]
    ranked = sorted(totals.items(), key=lambda kv: kv[1])
    cheapest = ranked[0][0] if ranked else None

    out = {
        "dish": dish,
        "servings": args.servings,
        "recipe": {"title": title, "url": url},
        "shopping_list": [{k: it[k] for k in ("name", "qty", "unit")} for it in items],
        "quotes": {it["name"]: it["quotes"] for it in items},
        "totals_gbp": dict(ranked),
        "cheapest": cheapest,
        "not_priced": missing,
    }
    print(json.dumps(out, indent=2))

    if not args.json:
        print("\n=== WEEK BASKET ===", file=sys.stderr, flush=True)
        for store, tot in ranked:
            marker = " ← cheapest" if store == cheapest else ""
            print(f"{store:<12} £{tot:.2f}{marker}", file=sys.stderr, flush=True)
        if missing:
            print(f"not priced: {', '.join(missing)}", file=sys.stderr, flush=True)


if __name__ == "__main__":
    main()
