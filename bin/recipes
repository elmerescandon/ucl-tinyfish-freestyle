#!/usr/bin/env python3
"""recipes - persistent, inspectable recipe cache for bin/meals.

Usage:
  recipes cache '<dish>'   find recipe, parse ingredients, store (search+fetch)
  recipes get '<dish>'     print stored recipe (JSON) or exit 1
  recipes list             list cached dishes
  recipes rm '<dish>'      delete one entry
"""

import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from lib import common
from lib.recipes_store import RECIPES_PATH, load_recipes, save_recipes


def cache(dish):
    recipes = load_recipes()
    url, title, ingredients = common.find_recipe(dish)
    if not ingredients:
        print(json.dumps({"error": "no recipe / ingredients found", "dish": dish}))
        sys.exit(1)
    save_recipes(dish, {
        "title": title,
        "url": url,
        "servings_base": 2,
        "ingredients": [
            {"raw": line, **dict(zip(("name", "qty", "unit"), common.clean_item(line)))}
            for line in ingredients
        ],
        "cached_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    })
    print(f"cached '{dish}' -> {RECIPES_PATH} ({len(ingredients)} ingredients)", file=sys.stderr)


def get(dish):
    r = load_recipes().get(dish)
    if not r:
        sys.exit(1)
    print(json.dumps({dish: r}, indent=2, ensure_ascii=False))


def list_recipes():
    for dish, r in sorted(load_recipes().items()):
        print(f"{dish}  ({len(r['ingredients'])} ingredients, cached {r.get('cached_at', '?')})")


def rm(dish):
    recipes = load_recipes()
    if dish not in recipes:
        print(f"'{dish}' not cached", file=sys.stderr)
        sys.exit(1)
    del recipes[dish]
    with open(RECIPES_PATH, "w") as f:
        json.dump(recipes, f, indent=2, ensure_ascii=False)
    print(f"removed '{dish}'", file=sys.stderr)


def main():
    ap = __import__("argparse").ArgumentParser(prog="recipes")
    ap.add_argument("command", choices=["cache", "get", "list", "rm"])
    ap.add_argument("dish", nargs="*")
    args = ap.parse_args()
    dish = " ".join(args.dish) if args.dish else ""
    if args.command in ("cache", "get", "rm") and not dish:
        ap.error(f"command '{args.command}' needs a <dish>")
    if args.command == "list":
        list_recipes()
    else:
        {"cache": cache, "get": get, "rm": rm}[args.command](dish)


if __name__ == "__main__":
    main()
